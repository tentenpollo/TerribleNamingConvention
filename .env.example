# =============================================================================
# [PROJECT_NAME] — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =============================================================================

# =============================================================================
# Application
# =============================================================================

# Secret key for signing JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=your-secret-key-here

# JWT token expiry in minutes (default: 60 minutes)
JWT_EXPIRE_MINUTES=60

# Environment — development | production
APP_ENV=development

# Log level — DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# =============================================================================
# Database (PostgreSQL)
# =============================================================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=projectdb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Full connection string — constructed from above or set directly
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/projectdb

# =============================================================================
# Redis
# =============================================================================

REDIS_URL=redis://redis:6379/0

# =============================================================================
# Qdrant
# =============================================================================

QDRANT_URL=http://qdrant:6333

# Optional: Qdrant API key if you're using Qdrant Cloud instead of self-hosted
# QDRANT_API_KEY=

# =============================================================================
# LLM Configuration (via LiteLLM)
# =============================================================================
# LiteLLM model strings: https://docs.litellm.ai/docs/providers
# Examples:
#   OpenAI:    gpt-4o, gpt-4o-mini, gpt-3.5-turbo
#   Anthropic: claude-sonnet-4-5, claude-haiku-4-5-20251001
#   Ollama:    ollama/llama3, ollama/mistral

# Default model used for querying (heavier, more capable)
LITELLM_QUERY_MODEL=gpt-4o-mini

# Default model used for ingestion pipeline (contextual chunking, summarization)
# Use a cheaper/faster model here to keep ingestion costs low
LITELLM_CONTEXT_MODEL=gpt-4o-mini

# API keys — only set the one(s) you need
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama base URL — only needed if using local Ollama
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# =============================================================================
# Ingestion Defaults
# =============================================================================
# These are system-wide defaults. Each project can override them in its config.

# Chunking strategy: naive | contextual | late
DEFAULT_CHUNKING_STRATEGY=contextual

# Number of documents ingested before a CAG update job is triggered
DEFAULT_CAG_REBUILD_THRESHOLD=50

# Maximum file size allowed for upload (in MB)
MAX_UPLOAD_SIZE_MB=50

# =============================================================================
# ARQ Worker
# =============================================================================

# Number of concurrent ARQ worker coroutines
ARQ_MAX_JOBS=10

# =============================================================================
# Frontend (Next.js)
# =============================================================================
# These are read by Next.js at build time for the frontend container.

# URL of the FastAPI backend — as seen from the browser
NEXT_PUBLIC_API_URL=http://localhost:8000
